# CodeMentor AI Environment Configuration Template
# Duplicate this file as .env and populate with your local values.
# NEVER commit real production secrets or API keys to Git.

# Frontend Configuration
NEXT_PUBLIC_APP_ENV=development
NEXT_PUBLIC_BACKEND_URL=http://localhost:8000

# Backend & Database Configuration (Phase 2 Integration)
SUPABASE_URL=your_supabase_project_url
SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Code Execution Sandbox (Judge0 CE)
JUDGE0_API_URL=http://localhost:2358
JUDGE0_AUTH_TOKEN=your_judge0_auth_token

# AI Mentor LLM API (Backend Controlled Tools)
LLM_API_KEY=your_llm_api_key
LLM_MODEL=gemini-1.5-pro
