# CodeMentor AI Environment Configuration Template
# Duplicate this file as .env and populate with your local values.
# NEVER commit real production secrets or API keys to Git.

# Frontend Configuration
NEXT_PUBLIC_APP_ENV=development
NEXT_PUBLIC_BACKEND_URL=http://localhost:8000
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key

# Backend & Database Configuration (Supabase PostgreSQL)
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key
SUPABASE_JWT_SECRET=replace_with_supabase_project_jwt_secret

# Code Execution Sandbox (Judge0 CE)
JUDGE0_API_URL=http://localhost:2358
JUDGE0_AUTH_TOKEN=your_judge0_auth_token

# AI Mentor LLM API (Backend Controlled Tools)
LLM_API_URL=https://api.openai.com/v1/chat/completions
LLM_API_KEY=your_llm_api_key
LLM_MODEL=gpt-4o-mini

# Optional app metadata
PROJECT_NAME=CodeMentor AI Backend
VERSION=1.0.0
