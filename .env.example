# CodeMentor AI Environment Configuration Template
# Put frontend settings in frontend/.env.local and backend settings in backend/.env.
# NEVER commit real production secrets or API keys to Git.

# Frontend Configuration
NEXT_PUBLIC_APP_ENV=development
NEXT_PUBLIC_BACKEND_URL=http://127.0.0.1:8000
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Legacy alternative to the publishable key.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Backend & Database Configuration (Supabase PostgreSQL)
SUPABASE_URL=https://your-project-ref.supabase.co
# Keep the service-role key server-only. A JWT secret is needed only for legacy HS256.
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_SECRET=

# Code Execution Sandbox (Judge0 CE)
JUDGE0_API_URL=
JUDGE0_AUTH_TOKEN=

# AI Mentor LLM API (Backend Controlled Tools)
LLM_API_URL=https://api.openai.com/v1/chat/completions
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
LLM_EMBEDDING_URL=
LLM_EMBEDDING_MODEL=text-embedding-3-small
# Optional separate embedding key. Otherwise the backend uses LLM_API_KEY.
LLM_EMBEDDING_API_KEY=
MENTOR_REQUEST_LIMIT=10

# Optional app metadata
PROJECT_NAME=CodeMentor AI Backend
VERSION=1.0.0
